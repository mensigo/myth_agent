# OpenRouter API key — used server-side only, never exposed to the browser.
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# OpenRouter model id in <vendor>/<model> form. Swappable without code changes.
# Defaults to openai/gpt-4o-mini when unset.
MODEL_ID=openai/gpt-4o-mini

# Which pantheon under content/ the tutor grounds answers in. Defaults to "greek".
ACTIVE_PANTHEON=greek
